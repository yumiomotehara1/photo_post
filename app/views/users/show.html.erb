<h1>マイページ</h1>

<p><strong>名前：</strong><%= @user.name %></p>
<p><strong>メールアドレス：</strong><%= @user.email %></p>

<div style="margin-bottom: 15px;">
  <span><strong>アイコン画像</strong></span>
  <% if @user.icon.attached? %>
    <%= image_tag @user.icon, size: "200x200", style: "vertical-align: top; margin-left: 10px;" %>
  <% else %>
    <%= image_tag "NoImage.png", size: "200x200", style: "vertical-align: top; margin-left: 10px;" %>
  <% end %>
</div>

<div>
  <%= link_to "編集", edit_user_path %>
</div>
