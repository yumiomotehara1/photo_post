<h1>投稿一覧</h1>

<% @posts.each do |post| %>
  <div style="margin-bottom: 30px;">
    <p><strong>タイトル：</strong><%= post.title %></p>
    <p><strong>投稿内容：</strong><%= post.content %></p>

    <div style="margin-bottom: 10px;">
      <span><strong>画像</strong></span>
      <% if post.image.attached? %>
        <%= image_tag post.image, size: "200x200", style: "vertical-align: top; margin-left: 10px;" %>
      <% else %>
        <%= image_tag "NoImage.png", size: "200x200", style: "vertical-align: top; margin-left: 10px;" %>
      <% end %>
    </div>

    <div>
      <%= link_to "投稿詳細", post_path(post) %><br>
      <%= link_to "投稿削除", post_path(post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    </div>
  </div>
<% end %>
