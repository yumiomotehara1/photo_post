<h1>投稿詳細</h1>

<p><strong>タイトル：</strong><%= @post.title %></p>
<p><strong>投稿内容：</strong><%= @post.content %></p>

<div style="margin-bottom: 15px;">
  <span><strong>画像</strong></span>
  <% if @post.image.attached? %>
    <%= image_tag @post.image, size: "250x250", style: "vertical-align: top; margin-left: 10px;" %>
  <% else %>
    <%= image_tag "NoImage.png", size: "250x250", style: "vertical-align: top; margin-left: 10px;" %>
  <% end %>
</div>

<div>
  <%= link_to "投稿を編集", edit_post_path(@post) %> |
  <%= link_to "投稿一覧へ戻る", posts_path %>
</div>

<div style="margin-top: 10px;">
  <%= button_to "投稿削除", post_path(@post), method: :delete, data: { turbo_confirm: "本当に削除しますか？" } %>
</div>
