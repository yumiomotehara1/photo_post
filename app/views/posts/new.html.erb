<h1>新規投稿</h1>

<%= form_with model: @post, local: true do |f| %>
  <div class="field">
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :content, "投稿内容" %>
    <%= f.text_area :content %>
  </div>

  <div class="field">
    <%= f.label :image, "画像" %>
    <%= f.file_field :image %>
  </div>


  <div class="actions">
    <%= f.submit "投稿" %>
  </div>
<% end %>

<%= link_to "投稿一覧へ戻る", posts_path %>
